---
import { getTickets, getSiteSettings } from '../lib/payload'
import type { Tenant } from '../lib/payload'

const tenant = Astro.locals.tenant as Tenant | null

if (!tenant) {
  return new Response('Tenant not found', { status: 404 })
}

const [tickets, settings] = await Promise.all([
  getTickets(tenant.id),
  getSiteSettings(tenant.id),
])

const primaryColor = settings?.primaryColor ?? '#3b82f6'
const logoText = settings?.logoText || tenant.name
const navLinks = settings?.navLinks ?? []

function formatPrice(price: number) {
  return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(price)
}
---

<!doctype html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Vé – {tenant.name}</title>
  <style define:vars={{ primaryColor }}>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: system-ui, sans-serif; }
    header {
      background: var(--primaryColor);
      color: white;
      padding: 1rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .logo { font-size: 1.5rem; font-weight: bold; }
    nav a { color: white; text-decoration: none; margin-left: 1.5rem; }
    nav a:hover { text-decoration: underline; }
    main { max-width: 900px; margin: 3rem auto; padding: 0 1.5rem; }
    h1 { font-size: 2rem; margin-bottom: 2rem; }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 1.5rem;
    }
    .card {
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      padding: 1.5rem;
      background: #fff;
      box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }
    .card-name { font-size: 1.1rem; font-weight: 600; margin-bottom: 0.5rem; }
    .card-desc { color: #666; font-size: 0.9rem; margin-bottom: 1rem; line-height: 1.5; }
    .card-price { font-size: 1.25rem; font-weight: 700; color: var(--primaryColor); }
    .empty { color: #888; font-style: italic; }
  </style>
</head>
<body>
  <header>
    <div class="logo">{logoText}</div>
    <nav>
      <a href="/">Trang chủ</a>
      {navLinks.map((link) => (
        <a href={link.url}>{link.label}</a>
      ))}
    </nav>
  </header>

  <main>
    <h1>Danh sách vé – {tenant.name}</h1>

    {tickets.length === 0 ? (
      <p class="empty">Chưa có vé nào.</p>
    ) : (
      <div class="grid">
        {tickets.map((ticket) => (
          <div class="card">
            <div class="card-name">{ticket.name}</div>
            {ticket.description && <div class="card-desc">{ticket.description}</div>}
            <div class="card-price">{formatPrice(ticket.price)}</div>
          </div>
        ))}
      </div>
    )}
  </main>
</body>
</html>
