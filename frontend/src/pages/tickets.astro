---
import { getTickets, getSiteSettings } from "../lib/payload";
import type { Tenant } from "../lib/payload";
import Layout from "../components/Layout.astro";
import TicketCard from "../components/TicketCard";

const tenant = Astro.locals.tenant as Tenant | null;

if (!tenant) {
  return new Response("Tenant not found", { status: 404 });
}

const [tickets, settings] = await Promise.all([
  getTickets(tenant.id),
  getSiteSettings(tenant.id),
]);

const primaryColor = settings?.theme?.primaryColor ?? "#3b82f6";
const heroBgFrom = settings?.theme?.heroBgFrom ?? "#1e3a5f";
const heroBgTo = settings?.theme?.heroBgTo ?? "#3b82f6";
---

<Layout tenant={tenant} settings={settings} title={`Vé – ${tenant.name}`}>
  <section
    class="page-hero"
    style={`background: linear-gradient(135deg, ${heroBgFrom} 0%, ${heroBgTo} 100%)`}
  >
    <div class="container">
      <h1 class="page-title" transition:name="hero-title">Danh sách vé</h1>
      <p class="page-sub">{tenant.name}</p>
    </div>
  </section>

  <section class="tickets-section container">
    {
      tickets.length === 0 ? (
        <div class="empty-state">
          <div class="empty-icon">🎟️</div>
          <p>Chưa có vé nào đang mở bán.</p>
          <a href="/" class="btn-primary" style={`background: ${primaryColor}`}>
            Về trang chủ
          </a>
        </div>
      ) : (
        <div class="ticket-grid">
          {tickets.map((ticket) => (
            <TicketCard
              client:visible
              ticket={ticket}
              tenantId={tenant.id}
              primaryColor={primaryColor}
            />
          ))}
        </div>
      )
    }
  </section>
</Layout>

<style>
  .page-hero {
    padding: 3rem 1.5rem 2.5rem;
    color: white;
    text-align: center;
  }
  .page-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.35rem;
  }
  .page-sub {
    font-size: 1rem;
    opacity: 0.8;
  }

  .tickets-section {
    padding: 3rem 1.5rem;
  }

  .ticket-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .empty-state {
    text-align: center;
    padding: 5rem 1rem;
    color: #888;
  }
  .empty-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }
  .empty-state p {
    font-size: 1rem;
    margin-bottom: 1.5rem;
  }
</style>
