---
import { getTickets, getSiteSettings } from '../lib/payload'
import type { Tenant } from '../lib/payload'
import Layout from '../components/Layout.astro'

const tenant = Astro.locals.tenant as Tenant | null

if (!tenant) {
  return new Response('Tenant not found', { status: 404 })
}

const [tickets, settings] = await Promise.all([
  getTickets(tenant.id),
  getSiteSettings(tenant.id),
])

const primaryColor = settings?.theme?.primaryColor ?? '#3b82f6'
const heroBgFrom = settings?.theme?.heroBgFrom ?? '#1e3a5f'
const heroBgTo = settings?.theme?.heroBgTo ?? '#3b82f6'

function formatPrice(price: number) {
  return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(price)
}
---

<Layout tenant={tenant} settings={settings} title={`Vé – ${tenant.name}`}>
  <!-- Page header -->
  <section class="page-hero" style={`background: linear-gradient(135deg, ${heroBgFrom} 0%, ${heroBgTo} 100%)`}>
    <div class="container">
      <h1 class="page-title" transition:name="hero-title">Danh sách vé</h1>
      <p class="page-sub">{tenant.name}</p>
    </div>
  </section>

  <!-- Tickets -->
  <section class="tickets-section container">
    {tickets.length === 0 ? (
      <div class="empty-state">
        <div class="empty-icon">🎟️</div>
        <p>Chưa có vé nào đang mở bán.</p>
        <a href="/" class="btn-primary" style={`background: ${primaryColor}`}>Về trang chủ</a>
      </div>
    ) : (
      <div class="ticket-grid">
        {tickets.map((ticket) => (
          <article class="ticket-card">
            <div class="ticket-name">{ticket.name}</div>
            {ticket.description && (
              <div class="ticket-desc">{ticket.description}</div>
            )}
            <div class="ticket-footer">
              <span class="ticket-price" style={`color: ${primaryColor}`}>
                {formatPrice(ticket.price)}
              </span>
              <button class="buy-btn" style={`background: ${primaryColor}`}>
                Mua ngay
              </button>
            </div>
          </article>
        ))}
      </div>
    )}
  </section>
</Layout>

<style>
  .page-hero {
    padding: 3rem 1.5rem 2.5rem;
    color: white;
    text-align: center;
  }
  .page-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.35rem;
  }
  .page-sub { font-size: 1rem; opacity: 0.8; }

  .tickets-section { padding: 3rem 1.5rem; }

  .ticket-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .ticket-card {
    background: white;
    border-radius: 14px;
    padding: 1.75rem 1.5rem;
    box-shadow: 0 2px 12px rgba(0,0,0,0.07);
    border: 1px solid #eef0f3;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .ticket-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.1);
  }
  .ticket-name { font-size: 1.1rem; font-weight: 700; }
  .ticket-desc { font-size: 0.875rem; color: #666; line-height: 1.55; flex: 1; }
  .ticket-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid #f0f0f0;
  }
  .ticket-price { font-size: 1.25rem; font-weight: 800; }
  .buy-btn {
    border: none;
    color: white;
    padding: 0.5rem 1.1rem;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.2s;
  }
  .buy-btn:hover { opacity: 0.85; }

  .empty-state {
    text-align: center;
    padding: 5rem 1rem;
    color: #888;
  }
  .empty-icon { font-size: 3rem; margin-bottom: 1rem; }
  .empty-state p { font-size: 1rem; margin-bottom: 1.5rem; }
</style>
