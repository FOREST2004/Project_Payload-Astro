---
import { getPageBySlug, getSiteSettings } from "../lib/payload";
import type { Tenant } from "../lib/payload";
import Layout from "../components/Layout.astro";
import ImageGallery from "../components/ImageGallery";
import HeroSection from "../components/HeroSection";

const tenant = Astro.locals.tenant as Tenant | null;

if (!tenant) {
  return new Response("Tenant not found", { status: 404 });
}

const [page, settings] = await Promise.all([
  getPageBySlug(tenant.id, "home"),
  getSiteSettings(tenant.id),
]);

const heroBgFrom = settings?.theme?.heroBgFrom ?? "#1e3a5f";
const heroBgTo = settings?.theme?.heroBgTo ?? "#3b82f6";
const primaryColor = settings?.theme?.primaryColor ?? "#3b82f6";
---

<Layout tenant={tenant} settings={settings} title={page?.title ?? tenant.name}>
  <HeroSection
    client:load
    title={page?.title ?? `Chào mừng đến ${tenant.name}`}
    content={page?.content}
    heroBgFrom={heroBgFrom}
    heroBgTo={heroBgTo}
  />

  {
    tenant.images && tenant.images.length > 0 && (
      <section class="gallery-section container">
        <ImageGallery client:idle images={tenant.images} />
      </section>
    )
  }

  {
    tenant.contact && (
      <section class="info-section container">
        <div class="info-grid">
          {tenant.contact.phone && (
            <div class="info-card">
              <div class="info-icon">📞</div>
              <div class="info-label">Hotline</div>
              <div class="info-value">{tenant.contact.phone}</div>
            </div>
          )}
          {tenant.contact.email && (
            <div class="info-card">
              <div class="info-icon">✉️</div>
              <div class="info-label">Email</div>
              <div class="info-value">{tenant.contact.email}</div>
            </div>
          )}
          {tenant.contact.address && (
            <div class="info-card">
              <div class="info-icon">📍</div>
              <div class="info-label">Địa chỉ</div>
              <div class="info-value">{tenant.contact.address}</div>
            </div>
          )}
        </div>
      </section>
    )
  }
</Layout>

<style define:vars={{ primaryColor }}>
  .gallery-section {
    padding: 3rem 1.5rem 0;
  }
  .info-section {
    padding: 3rem 1.5rem;
  }
  .info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
  }
  .info-card {
    background: white;
    border-radius: 12px;
    padding: 1.75rem 1.5rem;
    text-align: center;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.07);
  }
  .info-icon {
    font-size: 1.75rem;
    margin-bottom: 0.6rem;
  }
  .info-label {
    font-size: 0.78rem;
    color: #888;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.3rem;
  }
  .info-value {
    font-size: 1rem;
    font-weight: 600;
    color: var(--primaryColor);
  }
</style>
