            "url": "{{base_url}}/api/tenants",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tenant Name\",\n  \"slug\": \"tenant-slug\",\n  \"domain\": \"tenant.local\",\n  \"public\": true,\n  \"contact\": {\n    \"phone\": \"0900000000\",\n    \"email\": \"contact@tenant.local\",\n    \"address\": \"Địa chỉ\"\n  }\n}"
            }
          }
        },
        {
          "name": "Update",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "JWT {{token}}" }
            ],
            "url": "{{base_url}}/api/tenants/:id",
            "variable": [{ "key": "id", "value": "" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Name\"\n}"
            }
          }
        },
        {
          "name": "Delete",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "JWT {{token}}" }],
            "url": "{{base_url}}/api/tenants/:id",
            "variable": [{ "key": "id", "value": "" }]
