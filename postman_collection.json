      "name": "Tenants",
      "item": [
        {
          "name": "Get all",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/tenants",
              "host": ["{{base_url}}"],
              "path": ["api", "tenants"],
              "query": [
                { "key": "where[domain][equals]", "value": "vinwonders.local", "disabled": true },
                { "key": "where[slug][equals]", "value": "funpark", "disabled": true },
                { "key": "where[public][equals]", "value": "true", "disabled": true },
                { "key": "limit", "value": "10", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get by ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/tenants/:id",
            "variable": [{ "key": "id", "value": "" }]
          }
        },
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "JWT {{token}}" }
